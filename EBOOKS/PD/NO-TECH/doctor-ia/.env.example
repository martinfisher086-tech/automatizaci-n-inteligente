# =============================================================================
# Doctor IA — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# All NEXT_PUBLIC_* variables are exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic Claude API
# -----------------------------------------------------------------------------
# Required for chatbot and all AI content generation features.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# Stripe (Primary Payment Processor — USA + International)
# -----------------------------------------------------------------------------
# Get your keys at: https://dashboard.stripe.com/apikeys
# Use sk_test_* and pk_test_* during development.
# Switch to sk_live_* and pk_live_* for production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Product/Price IDs
# Create a product in Stripe dashboard → copy the price ID here
STRIPE_EBOOK_PRICE_ID=price_...

# -----------------------------------------------------------------------------
# Lemon Squeezy (Fallback Payment — LATAM + VAT compliance)
# -----------------------------------------------------------------------------
# Get your keys at: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=your_ls_key_here
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_PRODUCT_ID=your_product_id
LEMONSQUEEZY_VARIANT_ID=your_variant_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# -----------------------------------------------------------------------------
# n8n Automation
# -----------------------------------------------------------------------------
# Your n8n instance webhook URL for post-purchase delivery pipeline.
# Self-hosted: https://your-n8n.railway.app/webhook/doctor-ia
# Cloud: https://your-workspace.app.n8n.cloud/webhook/doctor-ia
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/doctor-ia

# Optional: n8n API key for programmatic workflow management
N8N_API_KEY=your_n8n_api_key_here

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
# PostHog — Product analytics (events, funnels, session recordings)
# Get your key at: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Analytics 4 — Conversion tracking
# Get your measurement ID at: https://analytics.google.com/
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-...

# -----------------------------------------------------------------------------
# Email — Resend (Transactional)
# -----------------------------------------------------------------------------
# Get your API key at: https://resend.com/api-keys
# Verify your domain before sending in production.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hola@doctoria.app
RESEND_FROM_NAME=Doctor IA

# Email sequence configuration
RESEND_WELCOME_TEMPLATE_ID=your_template_id_here

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Public URL of your deployed app (no trailing slash).
# Local development: http://localhost:3000
# Production: https://doctoria.app or your Vercel URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default language for the landing page
# Options: es (Spanish, default) | en (English)
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Ebook price in USD (displayed on landing page)
NEXT_PUBLIC_EBOOK_PRICE=17

# Ebook product name (used in emails and UI)
NEXT_PUBLIC_EBOOK_NAME_ES=Tu Mente, Tu Salud
NEXT_PUBLIC_EBOOK_NAME_EN=Your Mind, Your Health

# -----------------------------------------------------------------------------
# Airtable (Lead Tracking — MVP)
# -----------------------------------------------------------------------------
# Optional: used to log every purchase and chatbot lead.
# Migrate to Supabase when leads exceed 1,000/month.
# Get your PAT at: https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_PURCHASES_TABLE=Purchases

# -----------------------------------------------------------------------------
# Vercel (Deployment)
# -----------------------------------------------------------------------------
# These are automatically set by Vercel — do not add manually in Vercel dashboard.
# Only needed if running Vercel CLI locally.
# VERCEL_URL=your-deployment.vercel.app
# VERCEL_ENV=development|preview|production

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret for signing internal API requests between Next.js and n8n.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your_random_hex_secret_here

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://doctoria.app
